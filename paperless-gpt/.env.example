# paperless-gpt Configuration
# Copy this file to .env and customize the values for your deployment.

# Port the web UI / API listens on inside the container (reached via reverse proxy).
PAPERLESS_GPT_PORT=8080

# paperless-ngx connection.
# API token: paperless-ngx -> Settings -> My Profile -> API Token.
PAPERLESS_BASE_URL=https://paperless.pc-ziegert.de
PAPERLESS_API_TOKEN=changeme
# Public URL used for "open document" links in the paperless-gpt UI.
PAPERLESS_PUBLIC_URL=https://paperless.pc-ziegert.de

# Ollama backend for title/tag/correspondent generation
# (LLM_PROVIDER is fixed to ollama in docker-compose.yml).
OLLAMA_HOST=http://ollama.example.com:11434
LLM_MODEL=qwen3:8b
# Context window; local models default too low for whole documents.
OLLAMA_CONTEXT_LENGTH=8192
# Language hint for generated titles/tags.
LLM_LANGUAGE=German

# LLM-based OCR via Ollama (optional) — needs a vision-capable model,
# e.g. minicpm-v or llama3.2-vision. Leave empty to disable OCR features.
VISION_LLM_PROVIDER=
VISION_LLM_MODEL=

# Volume mappings (host source -> container target)
# Ownership is fixed by the image entrypoint (chown to 568:568) on startup.
# prompts: customizable prompt templates; db: SQLite processing state; config: app config.
VOLUME_PROMPTS_SRC='/mnt/ssd/appdata/paperless-gpt/prompts'
VOLUME_PROMPTS_DST=/app/prompts
VOLUME_DB_SRC='/mnt/ssd/appdata/paperless-gpt/db'
VOLUME_DB_DST=/app/db
VOLUME_CONFIG_SRC='/mnt/ssd/appdata/paperless-gpt/config'
VOLUME_CONFIG_DST=/app/config
